# Environment — copy this to .env and fill in values
NODE_ENV=development
PORT=3001
SOCKET_PORT=3002

# Database
MONGODB_URI=mongodb://localhost:27017/ai-video-factory

# Redis
REDIS_URL=redis://localhost:6379

# Storage
STORAGE_ROOT=./storage

# Grok CLI
GROK_CMD=grok
GROK_TIMEOUT_IMAGE=1800000
GROK_TIMEOUT_VIDEO=1800000
GROK_TIMEOUT_PER_SCENE=60000

# Batch processing
BATCH_SIZE=30
GROK_BATCH_SIZE=30

# Job quotas
JOB_STORAGE_QUOTA_BYTES=2147483648

# Cleanup
CLEANUP_FAILED_JOB_DAYS=7

# TTS (edge-tts = free offline, elevenlabs = api)
TTS_PROVIDER=edge-tts
ELEVENLABS_API_KEY=

# Optional Gemini for script analysis
GEMINI_API_KEY=

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# ── Local Whisper (faster-whisper) — Tier 3 transcription fallback ─────────────
# Absolute path to the venv Python executable.
# If unset, defaults to:
#   Windows → <backend>/whisper-env/Scripts/python.exe
#   Linux   → <backend>/whisper-env/bin/python
LOCAL_WHISPER_PYTHON=

# Absolute path to transcribe.py.
# If unset, defaults to <backend>/scripts/transcribe.py
LOCAL_WHISPER_SCRIPT=

# Model size: tiny | base | small | medium | large-v3
# Defaults to "small" — best CPU-only speed/accuracy tradeoff.
# First run per model will download weights from Hugging Face (~150MB for small).
LOCAL_WHISPER_MODEL=small

# ── Reasoning Provider Chain (scene-prompt building & script generation) ────────
# API keys for the 6-tier reasoning fallback chain.
# All are optional individually — the chain skips any provider with a missing key.

# Groq free tier — sign up at console.groq.com (no credit card required)
GROQ_API_KEY=

# OpenRouter free tier — sign up at openrouter.ai
OPENROUTER_API_KEY=

# GitHub personal access token with 'models:read' permission
# Create at github.com/settings/tokens — select 'models:read' scope
GITHUB_MODELS_TOKEN=

# AES-256 encryption key for API keys stored in MongoDB (custom providers).
# Must be exactly 64 hex characters (= 32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROVIDER_ENCRYPTION_KEY=

# Local GPU Workers & AI Film Studio pipelines
GPU_WORKER_URL=http://localhost:8188
LOCAL_TTS_ENABLED=true
LIP_SYNC_ENABLED=true
