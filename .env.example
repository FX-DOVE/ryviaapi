# Environment — AI Film Studio Pipeline
# Copy this to .env and fill in your values.
NODE_ENV=development
PORT=3001
SOCKET_PORT=3002

# Database
MONGODB_URI=mongodb://localhost:27017/ai-video-factory

# Redis
REDIS_URL=redis://localhost:6379

# Storage
STORAGE_ROOT=./storage

# ── Cloud storage (S3-compatible: AWS S3, Cloudflare R2, MinIO) ──
# Leave blank to use local mock storage (storage/public/mock-storage).
# For Cloudflare R2: S3_ENDPOINT is your account's R2 endpoint, S3_REGION=auto,
# and S3_FORCE_PATH_STYLE=true.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
PRESIGNED_URL_TTL_SECONDS=86400

# Batch processing
BATCH_SIZE=30

# Job quotas
JOB_STORAGE_QUOTA_BYTES=2147483648

# Cleanup
CLEANUP_FAILED_JOB_DAYS=7

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# ── Paystack (wallet top-ups) ────────────────────────────────────────────────
# Secret key from https://dashboard.paystack.com/#/settings/developer
# Payments are charged at 2× the studio credit the user receives.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# NGN (kobo) is the default Paystack currency. Set USD if your account supports it.
PAYSTACK_CURRENCY=NGN
# Used only when PAYSTACK_CURRENCY=NGN — convert USD charge to naira.
PAYSTACK_USD_NGN_RATE=1600

# GPU hourly rates used to price completed RunPod calls (USD).
GPU_L40S_USD_PER_HOUR=1.39
GPU_ADA48_USD_PER_HOUR=1.19

# AES-256 encryption key for API keys stored in MongoDB.
# Must be exactly 64 hex characters (= 32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROVIDER_ENCRYPTION_KEY=

ADMIN_EMAIL=

# ── AI Reasoning (script analysis, prompt building, directing) ──────────────
# Kimi on Runpod is the reasoning engine. The commercial fallbacks (Groq /
# OpenRouter / GitHub Models) were removed — the director runs on Kimi alone.
#   1. Runpod-hosted Kimi K2   (RUNPOD_KIMI_ENDPOINT_ID, needs RUNPOD_API_KEY)
#   2. optional: an explicit OpenAI-compatible endpoint (AI_API_ENDPOINT below).
#      Off unless you set it — a "point at my own endpoint" override, not an
#      automatic fallback. Set AI_MODEL to a model id that endpoint accepts.
# Examples:
#   AI_API_ENDPOINT=https://api.openai.com/v1       (OpenAI)
#   AI_API_ENDPOINT=http://localhost:11434/v1       (Ollama)
AI_API_KEY=
AI_API_ENDPOINT=
AI_MODEL=
AI_TEMPERATURE=
AI_MAX_TOKENS=

# ── Google Gemini (OpenAI-compatible endpoint) ───────────────────────────────
# Base URL: https://generativelanguage.googleapis.com/v1beta/openai/
# Auth: Bearer token (Gemini API key from Google AI Studio)
# Models: gemini-3.7-flash, gemini-3-pro-image-preview, gemini-2.5-flash-image, etc.
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.5-flash-lite

# How much script the director reads per decomposition call. Anything past this
# is not directed at all, so a feature screenplay needs the higher default.
DIRECTOR_SCRIPT_CHAR_LIMIT=48000

# ── Runpod (all GPU work: images, video, and optionally the LLM) ────────────
# One key for the account; each endpoint below is a serverless deployment on it.
RUNPOD_API_KEY=
RUNPOD_API_BASE=https://api.runpod.ai/v2

# Qwen-Image runs as TWO endpoints on purpose. fp8 is ~28 GB per pipeline, so
# two resident pipelines OOM a 48 GB card during warm_up() — outside any
# try/except, which kills the worker at init. Each endpoint pins QWEN_MODES to
# a single mode. img2img is NOT deployed; imageToImage() routes to edit.
#   text2image → character/environment locks and anchor keyframes
#   edit       → re-anchoring a keyframe from a reference sheet
RUNPOD_QWEN_T2I_ENDPOINT_ID=
RUNPOD_QWEN_EDIT_ENDPOINT_ID=

# LTX-2.5 image-to-video. Muxes a native audio track, which is why dialogue
# belongs in the video prompt. Ignores negative_prompt / steps / guidance
# (guidance-distilled), so the provider never sends them.
RUNPOD_LTX_ENDPOINT_ID=

# Kimi K2 for reasoning. Leave blank to use the OpenAI-compatible path above —
# there is no default, and a wrong id returns 401, not 404.
RUNPOD_KIMI_ENDPOINT_ID=

# Serverless cold start on this account measured at 445-685 s for Qwen and
# 7-11 min for LTX before a single frame is produced. Waits are sized for that.
RUNPOD_POLL_INTERVAL_MS=5000
RUNPOD_MAX_WAIT_MS=3600000
RUNPOD_IMAGE_MAX_WAIT_MS=1800000
RUNPOD_VIDEO_MAX_WAIT_MS=3600000

# ── Generation Defaults ────────────────────────────────────────────────────
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=24
SEGMENT_DURATION_SEC=8
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024

# LTX renders one of five fixed sizes: 450p 480p 576p 720p 1080p. Keyframes are
# generated at exactly this size so nothing is resampled before conditioning.
# Anything else falls back to 720p with a warning.
# Drop to 450p to iterate on a story cheaply.
LTX_RESOLUTION=720p

# ── Polling / Timeouts ─────────────────────────────────────────────────────
API_POLL_INTERVAL=5000
API_MAX_WAIT_MS=3600000

# ── Audio mix (underscore score under LTX native dialogue) ──────────────────
# Drama / movie / anime: LTX already muxes native dialogue + ambience. The mix
# layer builds procedural underscore beds from audioSpine and ducks them UNDER
# that native track. Silence cues = intentional score dips — never strip native.
# Default beds are ffmpeg-only (filtered noise / soft pads); no paid music API.
AUDIO_MIX_ENABLED=true
# Score bed level before sidechain ducking (dB). -12 keeps music under dialogue.
SCORE_DUCK_DB=-12
# Optional future remote music beds (unused unless both are set; offline default).
MUSIC_API_URL=
MUSIC_API_KEY=

# ── Voice-over / TTS (optional — NOT used for drama/movie/anime when clips
# already carry a native audio stream; reserved for documentary/explainer paths).
LOCAL_TTS_ENABLED=false
TTS_PROVIDER=
LIP_SYNC_ENABLED=false

# ── Optional alternate image API (Flux / OpenAI-compatible img endpoints) ────
# The default path uses Runpod Qwen (RUNPOD_QWEN_* above). Set these only if you
# point FluxImageProvider at an external image API instead.
IMAGE_API_KEY=
IMAGE_API_ENDPOINT=


# ── Optional alternate video API ─────────────────────────────────────────────
# Default video path is Runpod LTX (RUNPOD_LTX_ENDPOINT_ID). Placeholders only —
# never commit real secrets.
VIDEO_API_KEY=
VIDEO_API_ENDPOINT=


# ── Optional Groq (OpenAI-compatible reasoning) ──────────────────────────────
# Not required when RUNPOD_KIMI_ENDPOINT_ID or AI_API_ENDPOINT is set.
GROQ_API_KEY=
GROQ_API_ENDPOINT=https://api.groq.com/openai/v1
GROQ_MODEL=


# ── Segment reliability ──────────────────────────────────────────────────────
# How many times to retry a failed keyframe / LTX segment before marking failed.
SEGMENT_MAX_RETRIES=3
SEGMENT_RETRY_BASE_MS=2000

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
# Welcome, password reset, video-ready, and admin bulk mail.
# If EMAIL_HOST is unset, sends are skipped (logged) and never throw.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Reyvia <noreply@reyvia.app>
# Public app URL used in email links (password reset, video ready).
APP_URL=http://localhost:5173
